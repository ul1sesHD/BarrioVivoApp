<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS: cualquier petición en texto plano (http://) se bloquea. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
